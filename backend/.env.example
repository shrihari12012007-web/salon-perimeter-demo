# ==============================================================================
# SALON PERIMETER SHIMOGA — BACKEND ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env for local development or configure in Render Dashboard.
# NEVER commit the actual .env file or production secrets to Git!
# ==============================================================================

# Server Configuration
PORT=5000
NODE_ENV=development

# PostgreSQL Database Connection String
# On Render: Use the "Internal Database URL" (or "External Database URL") from Render PostgreSQL
DATABASE_URL=postgresql://salon_owner:your_secure_password@dpg-xxxxxx-a.oregon-postgres.render.com/salon_perimeter_db

# Allowed CORS Origins (Comma-separated for multiple origins)
# In production, this MUST include your GitHub Pages frontend origin:
CORS_ORIGIN=https://shrihari12012007-web.github.io,http://localhost:5500,http://127.0.0.1:5500,http://localhost:3000,http://localhost:8000

# Owner Admin Authentication (JWT)
# Generate a strong random key (e.g., node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
JWT_SECRET=replace_with_a_secure_random_secret_key_minimum_32_characters
JWT_EXPIRES_IN=24h

# Initial Owner Admin Account (Auto-seeded if no admin exists)
ADMIN_USERNAME=salon_owner
ADMIN_PASSWORD=replace_with_a_strong_password_123

# Optional: Email Notifications (Send email to owner when new enquiry arrives)
EMAIL_NOTIFICATIONS_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-notification-sender@gmail.com
SMTP_PASS=your-gmail-app-password
NOTIFICATION_RECIPIENT=salon-owner-inbox@gmail.com
